{
  "format": "signlingo.constraints",
  "version": 1,
  "expression": "ksl-meet",
  "request": "두 주먹의 1지를 펴서 마주 세웠다가 중앙으로 모아 마주 댄다.",
  "constraints": [
    {
      "id": "meet-index-shape",
      "kind": "handshape",
      "span": { "phase": "whole" },
      "hand": "both",
      "preset": "index",
      "note": "두 손 모두 주먹에서 검지만 편다."
    },
    {
      "id": "meet-index-upright",
      "kind": "palmFacing",
      "span": { "fraction": [0, 0.8] },
      "hand": "both",
      "facing": "inward",
      "pointing": "up",
      "toleranceDeg": 20,
      "note": "검지를 위로 세우고 두 손바닥이 서로 마주 보게 한다."
    },
    {
      "id": "meet-center",
      "kind": "symmetry",
      "span": { "fraction": [0.5, 0.8] },
      "axis": "lateral",
      "toleranceCm": 2,
      "note": "두 손을 몸 가운데로 모아 좌우 대칭이 되게 한다."
    },
    {
      "id": "meet-touch",
      "kind": "contact",
      "span": { "fraction": [0.5, 0.8] },
      "a": "left.index.mid",
      "b": "right.index.mid",
      "gapCm": 1.5,
      "toleranceCm": 0.5,
      "note": "가운데에서 두 검지가 마주 닿는다."
    }
  ]
}
